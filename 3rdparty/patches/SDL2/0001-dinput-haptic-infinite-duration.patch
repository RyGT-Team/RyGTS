From: SimracingUnc
Subject: [PATCH] dinput haptic: SDL_HAPTIC_INFINITY becomes INFINITE

SDL's DirectInput haptic backend computes dwDuration = length * 1000 in 32 bits, so
SDL_HAPTIC_INFINITY becomes 4294966296 us instead of INFINITE. Wheels (seen on a Simagic
Alpha EVO Sport) treat the "endless" constant and condition effects as finite and stop them,
so force feedback goes limp shortly after the game takes over.
Same fix as https://github.com/FH1-ReImagined/ForzaHorizon1-ReImagined/pull/337 (SDL patch 0147).

diff --git a/src/haptic/windows/SDL_dinputhaptic.c b/src/haptic/windows/SDL_dinputhaptic.c
index d375cb4..9caf2cc 100644
--- a/src/haptic/windows/SDL_dinputhaptic.c
+++ b/src/haptic/windows/SDL_dinputhaptic.c
@@ -591,6 +591,15 @@ static int SDL_SYS_SetDirection(DIEFFECT *effect, SDL_HapticDirection *dir, int
 #define CCONVERT(x) (((x) > 0x7FFF) ? 10000 : ((x)*10000) / 0x7FFF)
 /* Just converts. */
 #define CONVERT(x) (((x)*10000) / 0x7FFF)
+/* Effect length in ms to DirectInput microseconds. SDL_HAPTIC_INFINITY must become INFINITE:
+ * length * 1000 overflows 32 bits to 4294966296 us, which wheels treat as a finite effect. */
+static DWORD SDL_DINPUT_Duration(Uint32 length)
+{
+    if (length == SDL_HAPTIC_INFINITY || length > INFINITE / 1000UL) {
+        return INFINITE;
+    }
+    return length * 1000UL; /* In microseconds. */
+}
 /*
  * Creates the DIEFFECT from a SDL_HapticEffect.
  */
@@ -664,7 +673,7 @@ static int SDL_SYS_ToDIEFFECT(SDL_Haptic *haptic, DIEFFECT *dest,
         dest->lpvTypeSpecificParams = constant;
 
         /* Generics */
-        dest->dwDuration = hap_constant->length * 1000UL; /* In microseconds. */
+        dest->dwDuration = SDL_DINPUT_Duration(hap_constant->length);
         dest->dwTriggerButton = DIGetTriggerButton(hap_constant->button);
         dest->dwTriggerRepeatInterval = hap_constant->interval;
         dest->dwStartDelay = hap_constant->delay * 1000UL; /* In microseconds. */
@@ -710,7 +719,7 @@ static int SDL_SYS_ToDIEFFECT(SDL_Haptic *haptic, DIEFFECT *dest,
         dest->lpvTypeSpecificParams = periodic;
 
         /* Generics */
-        dest->dwDuration = hap_periodic->length * 1000UL; /* In microseconds. */
+        dest->dwDuration = SDL_DINPUT_Duration(hap_periodic->length);
         dest->dwTriggerButton = DIGetTriggerButton(hap_periodic->button);
         dest->dwTriggerRepeatInterval = hap_periodic->interval;
         dest->dwStartDelay = hap_periodic->delay * 1000UL; /* In microseconds. */
@@ -761,7 +770,7 @@ static int SDL_SYS_ToDIEFFECT(SDL_Haptic *haptic, DIEFFECT *dest,
         dest->lpvTypeSpecificParams = condition;
 
         /* Generics */
-        dest->dwDuration = hap_condition->length * 1000UL; /* In microseconds. */
+        dest->dwDuration = SDL_DINPUT_Duration(hap_condition->length);
         dest->dwTriggerButton = DIGetTriggerButton(hap_condition->button);
         dest->dwTriggerRepeatInterval = hap_condition->interval;
         dest->dwStartDelay = hap_condition->delay * 1000UL; /* In microseconds. */
@@ -792,7 +801,7 @@ static int SDL_SYS_ToDIEFFECT(SDL_Haptic *haptic, DIEFFECT *dest,
         dest->lpvTypeSpecificParams = ramp;
 
         /* Generics */
-        dest->dwDuration = hap_ramp->length * 1000UL; /* In microseconds. */
+        dest->dwDuration = SDL_DINPUT_Duration(hap_ramp->length);
         dest->dwTriggerButton = DIGetTriggerButton(hap_ramp->button);
         dest->dwTriggerRepeatInterval = hap_ramp->interval;
         dest->dwStartDelay = hap_ramp->delay * 1000UL; /* In microseconds. */
@@ -836,7 +845,7 @@ static int SDL_SYS_ToDIEFFECT(SDL_Haptic *haptic, DIEFFECT *dest,
         dest->lpvTypeSpecificParams = custom;
 
         /* Generics */
-        dest->dwDuration = hap_custom->length * 1000UL; /* In microseconds. */
+        dest->dwDuration = SDL_DINPUT_Duration(hap_custom->length);
         dest->dwTriggerButton = DIGetTriggerButton(hap_custom->button);
         dest->dwTriggerRepeatInterval = hap_custom->interval;
         dest->dwStartDelay = hap_custom->delay * 1000UL; /* In microseconds. */
